{
  "name": "@ecosy/markdoc",
  "version": "0.1.0",
  "description": "Headless markdown documentation framework for edge runtimes — GitHub as CMS via jsDelivr",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "markdoc-manifest": "./bin/markdoc-manifest.mjs"
  },
  "files": [
    "dist",
    "agents",
    "bin",
    "CHANGELOG.md"
  ],
  "agents": {
    "current": "v0",
    "prompts": {
      "markdoc": "$this://agents/v0/PROMPT.md"
    },
    "rules": {
      "markdoc": "$this://agents/v0/RULES.md"
    },
    "skills": {
      "$overview": "$this://agents/v0/skills/index.md",
      "markdoc-runtime": "$this://agents/v0/skills/markdoc-runtime/SKILL.md",
      "markdoc-plugin-system": "$this://agents/v0/skills/markdoc-plugin-system/SKILL.md",
      "markdoc-plugins-builtin": "$this://agents/v0/skills/markdoc-plugins-builtin/SKILL.md",
      "markdoc-imports": "$this://agents/v0/skills/markdoc-imports/SKILL.md",
      "markdoc-manifest": "$this://agents/v0/skills/markdoc-manifest/SKILL.md",
      "markdoc-engine": "$this://agents/v0/skills/markdoc-engine/SKILL.md",
      "markdoc-layout": "$this://agents/v0/skills/markdoc-layout/SKILL.md",
      "markdoc-nodejs-adapter": "$this://agents/v0/skills/markdoc-nodejs-adapter/SKILL.md",
      "markdoc-project-example": "$this://agents/v0/skills/markdoc-project-example/SKILL.md"
    },
    "workflows": [
      "prompts.markdoc",
      "rules.markdoc",
      "skills.markdoc-runtime",
      "skills.markdoc-plugin-system",
      "skills.markdoc-plugins-builtin",
      "skills.markdoc-imports",
      "skills.markdoc-manifest",
      "skills.markdoc-engine",
      "skills.markdoc-layout",
      "skills.markdoc-nodejs-adapter",
      "skills.markdoc-project-example"
    ],
    "examples": {
      "project": {
        "repository": "github.com:material-atomic/ecosy-markdoc",
        "url": "https://markdoc.ecosy.io"
      }
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugins": {
      "source": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.js"
    },
    "./plugins/*": {
      "source": "./src/plugins/*.ts",
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.mjs",
      "require": "./dist/plugins/*.js"
    },
    "./imports": {
      "source": "./src/imports/index.ts",
      "types": "./dist/imports/index.d.ts",
      "import": "./dist/imports/index.mjs",
      "require": "./dist/imports/index.js"
    },
    "./imports/*": {
      "source": "./src/imports/*.ts",
      "types": "./dist/imports/*.d.ts",
      "import": "./dist/imports/*.mjs",
      "require": "./dist/imports/*.js"
    },
    "./nodejs": {
      "source": "./src/nodejs.ts",
      "types": "./dist/nodejs.d.ts",
      "import": "./dist/nodejs.mjs",
      "require": "./dist/nodejs.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist .doctest-cache",
    "build": "yarn lint && yarn typecheck && yarn doctest --silent && rollup -c",
    "prepublishOnly": "yarn clean && yarn build",
    "dev": "rollup -c --watch",
    "lint": "eslint src/ scripts/ bin/",
    "lint:fix": "eslint src/ scripts/ bin/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/ scripts/ bin/",
    "format:check": "prettier --check src/ scripts/ bin/",
    "doctest": "node scripts/doctest.mjs",
    "manifest:check": "node bin/markdoc-manifest.mjs --root docs/content",
    "manifest:sync": "node bin/markdoc-manifest.mjs --root docs/content --write",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/material-atomic/ecosy-markdoc.git"
  },
  "keywords": [
    "ecosy",
    "markdoc",
    "markdown",
    "documentation",
    "cms",
    "headless",
    "edge",
    "cloudflare-workers",
    "typescript"
  ],
  "author": "material-atomic",
  "dependencies": {
    "@ecosy/classable": "^0.2.0",
    "@ecosy/core": "^0.3.4",
    "@ecosy/json": "^0.1.0",
    "front-matter": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
