{
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "target": "es2015",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "docs",
    "node_modules",
    "dist"
  ]
}